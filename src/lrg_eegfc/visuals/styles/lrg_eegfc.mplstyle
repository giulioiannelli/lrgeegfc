# lrg_eegfc canonical matplotlib style (lapbrain / IMCOH_ABS / COHORT_N10)
#
# Activated via:
#     from lrg_eegfc.visuals.styles import use_lrg_style
#     use_lrg_style()
#
# Defaults are tuned for compact 2 x 2 / 1 x 4 publication figures.
# Anything not explicitly set inherits matplotlib's default.

# --- fonts -------------------------------------------------------------
font.size: 9
axes.titlesize: 10
axes.labelsize: 9
xtick.labelsize: 7
ytick.labelsize: 7
legend.fontsize: 7
legend.title_fontsize: 8
figure.titlesize: 10

# --- ticks -------------------------------------------------------------
xtick.major.size: 3.0
ytick.major.size: 3.0
xtick.minor.size: 1.5
ytick.minor.size: 1.5
xtick.major.width: 0.6
ytick.major.width: 0.6
xtick.minor.width: 0.4
ytick.minor.width: 0.4
xtick.major.pad: 2.0
ytick.major.pad: 2.0
xtick.minor.pad: 2.0
ytick.minor.pad: 2.0
xtick.direction: out
ytick.direction: out

# --- axes --------------------------------------------------------------
axes.linewidth: 0.6
axes.titlepad: 4.0
axes.labelpad: 3.0
axes.spines.top: True
axes.spines.right: True
axes.grid: False

# --- lines / markers ---------------------------------------------------
lines.linewidth: 1.2
lines.markersize: 4
patch.linewidth: 0.6

# --- legend ------------------------------------------------------------
legend.frameon: False
legend.handlelength: 1.5
legend.handletextpad: 0.5
legend.borderaxespad: 0.4
legend.columnspacing: 1.0

# --- images / colormap ------------------------------------------------
# Default colormap for any imshow / pcolormesh that does not explicitly
# pass cmap=. Inferno: perceptually uniform, colour-blind friendly,
# dark→bright sequential. Override per-call when the data semantics
# need a divergent or reversed map (e.g. cmap="RdBu_r" for signed Δ,
# cmap="viridis_r" if you want small distances to be bright).
image.cmap: inferno

# --- output ------------------------------------------------------------
# TrueType-embedded fonts so PDFs are editable in Illustrator/Inkscape.
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none
savefig.bbox: standard
savefig.dpi: 300
figure.dpi: 100
